{
  // One Cloudflare Worker serves the built app (./dist) and the AI endpoint (/api/*).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamtee-builder",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers AI: free daily allowance, no API key in the browser.
  "ai": { "binding": "AI" }
}
